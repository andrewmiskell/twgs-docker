# Copy to .env and edit.

# Which installer to use: 219, 220 or 220B. Raising this upgrades on next start.
TWGS_VERSION=220B

# Set to yes once you have read and accepted the TWGS license (see README).
TWGS_ACCEPT_LICENSE=no

# Set on first install only. Change it later in the TWGS UI. Blank = generated and logged.
TWGS_ADMIN_PASSWORD=

# Web UI password, 8 characters maximum. Blank = generated and logged.
VNC_PASSWORD=

# Timezone for game schedules and logs.
TZ=UTC

# Folder holding TWGS219.exe, TWGS220.exe, TWGS220B.exe.
TWGS_INSTALLERS_DIR=./installers
